# Compose usa este arquivo por padrão; prod é sempre: docker compose -f compose.prod.yml ...
COMPOSE_FILE=compose.dev.yml

APP_NAME="Demandas Internas"
# Gere com: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_URL=http://localhost:8080
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

DB_DATABASE=demandas
DB_USERNAME=demandas
DB_PASSWORD=demandas

SANCTUM_STATEFUL_DOMAINS=localhost:8080

VITE_APP_TITLE="Demandas Internas"
